# ==========================================================
# SOLCARE / SOLIS - VARIÁVEIS DE AMBIENTE
# Nunca envie valores reais para o GitHub.
# ==========================================================

# SolisCloud
SOLIS_API_ID=
SOLIS_API_SECRET=
SOLIS_BASE_URL=https://www.soliscloud.com:13333
SOLIS_STATION_ID=

# Supabase / PostgreSQL
DATABASE_URL=

# WhatsApp / Whapi
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=
WHAPI_CHAT_ID=
AUTHORIZED_CHAT_ID=

# Inteligência Artificial - Groq
AI_ENABLED=true
AI_MEMORY_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_COMPLETION_TOKENS=600

# Localização da usina.
# O SolCare tenta usar latitude/longitude da própria Solis se estes campos
# não forem configurados.
STATION_LATITUDE=
STATION_LONGITUDE=

# Fallback climático quando Open-Meteo estiver limitado.
WEATHERAPI_KEY=

# Economia
ENERGY_TARIFF=
AVERAGE_CONSUMPTION_KWH=
TUSD_FIO_B_KWH=
FIO_B_PERCENTAGE=
REPORT_YEAR_MONTH=

# Manutenção preventiva
MAINTENANCE_HISTORY_DAYS=45
MAINTENANCE_RECENT_DAYS=4
MAINTENANCE_BASELINE_DAYS=7
MAINTENANCE_CONFIRMATION_DAYS=5
MAINTENANCE_DROP_PERCENT=25
MAINTENANCE_MIN_RADIATION_WH_M2=3000

# Alarmes Solis
SOLIS_ALARM_LOOKBACK_DAYS=2
SOLIS_ALARM_NOTIFY_MAX_AGE_MINUTES=120
